/*
 * label_text.gq — Golden-test fixture pre-authoring pixel-identity
 * baseline for the label/text render path (draw_label_stack() ->
 * Graphics_drawString(), gamequeer.c/grlib) ahead of the Stage 2 render
 * rework (epic duplico/qc2024#47, which rewrites grlib's text rendering
 * onto a row-major pixel driver). This locks in TODAY's known-correct
 * rendering so Stage 2 can be asserted pixel-for-pixel identical to it --
 * the same discipline that protected Stage 1 (mask_encoding_{a,b,c}.gq,
 * rowmajor_byte_blit.gq, edge_coverage.gq). No committed golden fixture
 * exercises the label path at all before this one.
 *
 * Adapted from examples/perf_text/perf_text.gq (as
 * examples/games/perf/perf_text.gq at the time, duplico/gamequeer#298;
 * moved onto the game-as-directory layout by #440), which documents the
 * full authoring rationale and gotchas found (see
 * gqc/docs/authoring-and-perf-carts.md §§2, 8-9) -- this fixture keeps the
 * same three stages and content, re-headered for the golden-test
 * convention.
 *
 * Three stages, navigated with A/B:
 *
 *   start   -- the four label slots (GQI_LABEL{1..4}_{X,Y}, GQS_LABEL{1..4})
 *              exercised together:
 *                label1 top-left corner (0,0), 21 chars (the max usable
 *                  length: GQ_STR_SIZE-1), both label-flags bits set
 *                  (color-inverted + opaque background) -- the zero-origin
 *                  corner case.
 *                label2 mid-screen, built from `str(x)` int-cast +
 *                  string concatenation of a literal, a persistent str var,
 *                  and a volatile int -- opaque background only.
 *                label3 positioned so a *full 21-char* string runs well past
 *                  the right and bottom edges of the display (x=100,y=120:
 *                  100+21*6=226 >> 128) -- the single highest-value
 *                  regression case for a row-major rewrite: background-fill
 *                  clipping *and* glyph clipping together, at both the
 *                  right and bottom edges simultaneously. Opaque +
 *                  color-inverted (see the authoring note in the source
 *                  cart on why non-opaque would render invisible here).
 *                label4 bottom-left corner (0,120), a negative `str(x)` cast
 *                  concatenated with a literal -- default (transparent,
 *                  non-inverted) flags.
 *              input(A) increments the volatile score and re-renders label2
 *                (proves the str(x)+concat label updates dynamically, not
 *                just static text). input(B) moves to `glyphs1`.
 *
 *   glyphs1 -- full printable-ASCII glyph-coverage sweep, part 1: labels 1-4
 *              each carry a 21-char consecutive slice of the font's glyph
 *              range (0x20 ' ' .. 0x7E '~', 95 glyphs), covering all of it
 *              except '"' (0x22) and '\' (0x5C) -- both awkward to author
 *              literally inside a `"`-quoted .gq string literal (the
 *              grammar's plain string token has no escape handling), so
 *              this is an *authoring* gap, not a font gap. A row-major
 *              rewrite could plausibly corrupt only specific glyph bit
 *              patterns (e.g. glyphs with lone pixels in the last
 *              column/row of their 6x8 cell), which a small hand-picked
 *              string would likely miss -- this sweep is deliberately
 *              exhaustive. input(A) moves to `glyphs2` (the remaining 9
 *              glyphs); input(B) returns to `start`.
 *
 *   glyphs2 -- the tail of the glyph sweep ('v'..'~', 9 chars) in label1.
 *              input(A) returns to `glyphs1`; input(B) returns to `start`.
 *
 * Four ctest cases share this one compiled cart (see tests/CMakeLists.txt):
 *   golden_framebuffer_label_text_start        (TICKS=1)  -- pristine enter.
 *   golden_framebuffer_label_text_start_scored (TICKS=3, INPUT=A,A,A) --
 *     proves dynamic str(x)+concat content, not just static text.
 *   golden_framebuffer_label_text_glyphs1 (TICKS=2, INPUT=B) -- `gostage`
 *     defers the new stage's `enter` to the *next* tick (handle_events() is
 *     a single linear pass over event types in a fixed order, and `B`'s
 *     handler is processed after ENTER's index in that same pass -- see the
 *     authoring guide's "Driving menu navigation headlessly" section), so
 *     this needs TICKS=2, not 1.
 *   golden_framebuffer_label_text_glyphs2 (TICKS=3, INPUT=B,A) -- same
 *     one-tick-per-transition rule applied twice.
 *
 * Emulator-confirmed (headless --dump + scripted --input): all four
 * captures render as expected, including label3's off-canvas clipping, the
 * str(x)/concatenation content in label2/label4, and the full glyph sweep.
 * See the PR body for the exact validation transcript.
 *
 * How to reproduce the compiled fixture (label_text.gqgame):
 *
 *   From the gamequeer repo root, using the builder container:
 *     docker run --rm -v $(pwd):/workspaces/gamequeer --workdir /workspaces/gamequeer \
 *         --user $(id -u):$(id -g) gamequeer-builder:latest \
 *         /bin/bash -c "PYTHONPATH=gqc/src python -m gqc compile --no-mem-map \
 *             -o gamequeer/tests/golden gamequeer/tests/golden/label_text.gq"
 *
 *   Or via the Makefile target:
 *     make golden-fixture
 */

game {
    id = 1;
    title := "LabelText";
    author := "test";
    starting_stage = start;
}

persistent {
    str player_name := "Ada";
}

volatile {
    int score = 0;
    str score_str := "";
    str neg_str := "";
}

stage start {
    event enter {
        // label1: top-left corner, max-length (21 char) string, both flag
        // bits set (color-inverted + opaque background).
        GQI_LABEL1_X = 0;
        GQI_LABEL1_Y = 0;
        GQS_LABEL1 := "TopLeft(0,0) 21chars!";

        // label2: str(int) cast + concatenation of a literal, a persistent
        // str var, and a volatile int -- updated again on input(A) below.
        // Casts into an intermediate str var (score_str) here rather than
        // inline (`... + str(score)`, gamequeer#386) to keep this fixture's
        // coverage of the whole-RHS `str(x)` -> dst form (CommandCastStr,
        // no intermediate register) alongside label4's; the inline form has
        // its own coverage in gqc/tests/test_grammar.py and friends.
        GQI_LABEL2_X = 30;
        GQI_LABEL2_Y = 60;
        score_str := str(score);
        GQS_LABEL2 := "Hi " + player_name + " score=" + score_str;

        // label3: full 21-char string positioned to run well past the
        // right and bottom edges -- the highest-value clipping regression
        // case for a row-major rewrite. Opaque + color-inverted (white
        // filled background, black text): with the canvas black underneath,
        // a *non*-opaque color-inverted label here would draw black text on
        // an untouched black background and be invisible -- opaque makes
        // both the background fill clip *and* the text clip visible and
        // assertable.
        GQI_LABEL3_X = 100;
        GQI_LABEL3_Y = 120;
        GQS_LABEL3 := "EdgeRightBottom21chr!";

        // label4: negative str(int) cast + concatenation, bottom-left
        // corner, default (transparent, non-inverted) flags.
        GQI_LABEL4_X = 0;
        GQI_LABEL4_Y = 120;
        neg_str := str(-12345);
        GQS_LABEL4 := neg_str + "end";

        // Flags: label1 = color-invert(bit0) + opaque(bit1); label2 =
        // opaque(bit1) only; label3 = color-invert(bit0) + opaque(bit1);
        // label4 = (unset) transparent, non-inverted.
        // NB: written as a precomputed literal, not a chained `<<`/`|`
        // expression -- a 5-term chain of shift/or operators exhausts the
        // compiler's 4-register int-operand pool ("No free registers
        // available"; see IntExpression in gqc/src/gqc/datamodel.py).
        // = (1<<0) | (1<<1) | (1<<9) | (1<<16) | (1<<17)
        GQI_LABEL_FLAGS = 197123;
    }

    event input(A) {
        score = score + 1;
        score_str := str(score);
        GQS_LABEL2 := "Hi " + player_name + " score=" + score_str;
    }

    event input(B) {
        gostage glyphs1;
    }
}

stage glyphs1 {
    event enter {
        GQI_LABEL_FLAGS = 0;

        GQI_LABEL1_X = 0;
        GQI_LABEL1_Y = 0;
        GQS_LABEL1 := " !#$%&'()*+,-./012345";

        GQI_LABEL2_X = 0;
        GQI_LABEL2_Y = 10;
        GQS_LABEL2 := "6789:;<=>?@ABCDEFGHIJ";

        GQI_LABEL3_X = 0;
        GQI_LABEL3_Y = 20;
        GQS_LABEL3 := "KLMNOPQRSTUVWXYZ[]^_`";

        GQI_LABEL4_X = 0;
        GQI_LABEL4_Y = 30;
        GQS_LABEL4 := "abcdefghijklmnopqrstu";
    }

    event input(A) {
        gostage glyphs2;
    }

    event input(B) {
        gostage start;
    }
}

stage glyphs2 {
    event enter {
        GQI_LABEL1_X = 0;
        GQI_LABEL1_Y = 0;
        GQS_LABEL1 := "vwxyz{|}~";
        GQS_LABEL2 := "";
        GQS_LABEL3 := "";
        GQS_LABEL4 := "";
    }

    event input(A) {
        gostage glyphs1;
    }

    event input(B) {
        gostage start;
    }
}
