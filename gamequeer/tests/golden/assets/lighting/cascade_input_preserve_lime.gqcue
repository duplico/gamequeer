/*
 * cascade_input_preserve_lime.gqcue -- "the R event reached the destination
 * stage" indicator cue for cascade_input_preserve.gq (gamequeer#455). One
 * hold frame, lime, duration 4 (1 subtick) -- the minimum legal frame
 * duration (LEDS_SUBTICKS), same shape as if_literal_condition_lime.gqcue.
 * Not looping (played via a foreground `cue` statement, which never forces
 * loop=1 the way bgcue does), so it plays once and then the LEDs go dark --
 * see cascade_input_preserve.gq's header comment for the full tick-by-tick
 * timeline this produces.
 */

frame {
    duration = 4;
    colors {
        lime,
        lime,
        lime,
        lime,
        lime
    }
}
