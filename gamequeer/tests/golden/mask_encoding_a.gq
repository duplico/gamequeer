/*
 * mask_encoding_a.gq — Golden-test fixture locking in the masked-sprite fix
 * from gamequeer#262/PR#272 (removal of a vestigial unmasked pre-draw in
 * gq_draw_image_with_mask), covering the RLE-7 and UNCOMPRESSED 1bpp image
 * encodings that gqc's Frame cooker can actually produce.
 *
 * Two fganim/fgmask pairs are rendered simultaneously, using both
 * concurrent foreground slots the VM supports:
 *
 *   fganim(1) / fgmask(1): solid_white.png (RLE7) masked by
 *                          tophalf_mask.png (RLE7)
 *     -- this is the exact shape from #262's manual bug repro: "a 32x32
 *        test sprite with a top-half-only mask". Pre-fix, this rendered
 *        as a fully solid 32x32 square; post-fix, only the top half
 *        should be visible.
 *
 *   fganim(2) / fgmask(2): checker.png (UNCOMPRESSED, since a dense
 *                          checkerboard is the worst case for RLE) masked
 *                          by tophalf_mask.png (RLE7)
 *     -- exercises an UNCOMPRESSED-encoded *image* combined with an
 *        RLE7-encoded mask.
 *
 * See mask_encoding_b.gq for the remaining two encoding combinations
 * (RLE7 image + UNCOMPRESSED mask, UNCOMPRESSED image + UNCOMPRESSED
 * mask).
 *
 * gqc's Frame encoder (gqc/src/gqc/datamodel.py, class Frame) currently
 * only ever selects between IMAGE_FMT_1BPP_UNCOMP and
 * IMAGE_FMT_1BPP_COMP_RLE7 (whichever is smaller) -- RLE4 is commented
 * out of both the `image_types` size-comparison dict and the
 * `image_formats` lookup table, so it cannot be produced by the public
 * gqc compile pipeline as of this writing. That's a real, separate gap;
 * see the PR body for #272's golden-test follow-up.
 *
 * HISTORICAL NOTE (fixed by #276): earlier revisions of this golden PGM had
 * the single pixel at (39,23) -- the bottom-right corner of fganim(1)'s
 * visible (top) half -- rendering as background instead of sprite white.
 * That was NOT a masking bug and was unrelated to #262/#272: it was a
 * distinct, pre-existing off-by-one in gq_image_get_pixel's RLE decode
 * (oled.c). When an RLE run boundary is consumed (pixel_repeat hits 0),
 * gq_image_load_byte() is called to prefetch the *next* run before the
 * *current* pixel's value is returned, and gq_image_load_byte()
 * unconditionally overwrote frame->pixel_value for rle_type 4/7. So the
 * last pixel of any RLE4/7 run whose value differed from the next run's
 * value was rendered with the *next* run's value instead of its own. It
 * was invisible whenever consecutive runs shared a value (e.g.
 * solid_white.png's own 8 same-valued RLE7 bytes), which is why it only
 * showed up here, at tophalf_mask.png's one visible->hidden transition.
 * Fixed in gamequeer#276 by returning the current run's captured pixel
 * value from gq_image_get_pixel() before the run-boundary prefetch can
 * overwrite frame->pixel_value; the golden PGM was regenerated as part of
 * that fix (pixel (39,23) is now correctly sprite white).
 *
 * NUANCE: tophalf_mask.png is reused as-is for fgmask(2), so the #276 fix
 * above actually fires *twice* in this fixture -- visibly at (39,23) for
 * fganim(1), and invisibly at fganim(2)'s corresponding pixel (39,87). It's
 * invisible there only because checker.png's bit at that mask's local
 * (31,15) transition happens to be 0: "not drawn, background 0" and "drawn
 * with sprite value 0" render identically. checker.png itself never
 * exercises the RLE path at all -- gqc's Frame encoder picks
 * IMAGE_FMT_1BPP_UNCOMP for it, since RLE7 would be ~7.7x larger for a
 * dense checkerboard. Net effect: editing checker.png's *content* (not
 * just this comment) could flip that local (31,15) bit and surface a
 * second pixel diff here with no code change -- don't be surprised.
 *
 * How to reproduce the compiled fixture (mask_encoding_a.gqgame):
 *
 *   From the gamequeer repo root, using the builder container:
 *     docker run --rm -v $(pwd):/workspaces/gamequeer --workdir /workspaces/gamequeer \
 *         --user $(id -u):$(id -g) gamequeer-builder:latest \
 *         /bin/bash -c "cd gamequeer/tests/golden && PYTHONPATH=/workspaces/gamequeer/gqc/src \
 *             python -m gqc compile --no-mem-map -o . mask_encoding_a.gq"
 *
 *   Or via the Makefile target:
 *     make golden-fixture
 */

game {
    id = 1;
    title := "MaskEncA";
    author := "test";
    starting_stage = mask_test;
}

animations {
    sprite1 <- "solid_white.png" {
        w = 32;
        h = 32;
    }

    mask1 <- "tophalf_mask.png" {
        w = 32;
        h = 32;
    }

    sprite2 <- "checker.png" {
        w = 32;
        h = 32;
    }

    mask2 <- "tophalf_mask.png" {
        w = 32;
        h = 32;
    }
}

stage mask_test {
    event enter {
        GQI_FGANIM1_X = 8;
        GQI_FGANIM1_Y = 8;
        play fganim(1) sprite1;
        play fgmask(1) mask1;

        GQI_FGANIM2_X = 8;
        GQI_FGANIM2_Y = 72;
        play fganim(2) sprite2;
        play fgmask(2) mask2;
    }
}
