/*
 * perf_mask.gq -- masked-rendering perf test cart.
 *
 * Exercises the masked foreground blit path (gq_draw_image_with_mask) across
 * a full 128x128 screen, so hardware profiling can measure masked-rendering
 * cost. No "wild" game uses masks, so this is the first cart that drives that
 * path at full-screen scale (epic duplico/qc2024#45).
 *
 * A full-screen solid-circle sprite (RLE7-encoded) is drawn through a
 * horizontal-band mask (RLE7-encoded): only the banded rows of the sprite are
 * composited, the rest shows background. Both anim and mask are single static
 * frames, drawn once from `enter` -- identical structure to the committed
 * mask_encoding_{a,b}.gq golden fixtures, just scaled to the whole display.
 *
 * Confirmed frame encodings (from map.txt .frame section):
 *   perf_fg_circle.png -> IMAGE_FMT_1BPP_COMP_RLE7
 *   perf_mask_bands.png -> IMAGE_FMT_1BPP_COMP_RLE7
 */

game {
    id = 101;
    title := "PerfMask";
    author := "perf";
    starting_stage = start;
}

animations {
    fg   <- "perf_fg_circle.png";
    mask <- "perf_mask_bands.png";
}

stage start {
    event enter {
        GQI_FGANIM1_X = 0;
        GQI_FGANIM1_Y = 0;
        GQI_FGMASK1_X = 0;
        GQI_FGMASK1_Y = 0;
        play fganim(1) fg;
        play fgmask(1) mask;
    }
}
