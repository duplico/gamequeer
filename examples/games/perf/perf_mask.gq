/*
 * perf_mask.gq -- masked-rendering perf test cart (animated).
 *
 * Exercises the masked foreground blit path (gq_draw_image_with_mask) across
 * a full 128x128 screen, so hardware profiling can measure masked-rendering
 * cost. No "wild" game uses masks, so this is the first cart that drives that
 * path at full-screen scale (epic duplico/qc2024#45).
 *
 * A pulsing full-screen solid-circle sprite (RLE7-encoded, 6 frames) is drawn
 * through a marching horizontal-band mask (RLE7-encoded, 6 frames, same
 * frame count/timing as the sprite so they stay paired -- see
 * gen_perf_assets.py's header comment on why mismatched frame counts would
 * silently fall back to an unmasked draw). Only the banded rows of the
 * sprite are composited each frame; the rest shows background.
 *
 * Unlike a single static frame (which draws once on `enter` and then idles,
 * giving nothing to perf-measure), this animates: `fgdone(1)` fires when the
 * sprite's 6-frame cycle completes and immediately replays both fganim(1)
 * and fgmask(1), so the masked-blit path re-runs on every frame advance for
 * as long as the cart is left running -- perf-usable.
 *
 * Confirmed frame encodings (from map.txt .frame section): every frame of
 * both fg and mask -> IMAGE_FMT_1BPP_COMP_RLE7. Confirmed multi-frame
 * advance in the headless emulator (see PR description / report).
 */

game {
    id = 101;
    title := "PerfMask";
    author := "perf";
    starting_stage = start;
}

animations {
    fg <- "perf_mask_fg.gif" {
        frame_rate = 5;
        dithering := "none";
    }
    mask <- "perf_mask_mask.gif" {
        frame_rate = 5;
        dithering := "none";
    }
}

stage start {
    event enter {
        GQI_FGANIM1_X = 0;
        GQI_FGANIM1_Y = 0;
        GQI_FGMASK1_X = 0;
        GQI_FGMASK1_Y = 0;
        play fganim(1) fg;
        play fgmask(1) mask;
    }

    event fgdone(1) {
        play fganim(1) fg;
        play fgmask(1) mask;
    }
}
