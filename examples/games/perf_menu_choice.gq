/*
 * perf_menu_choice.gq -- choice-menu rendering regression-content cart.
 *
 * Exercises the choice-menu path (draw_menu_choice() in menu.c) ahead of the
 * Stage 2 render rework (epic duplico/qc2024#47, which touches menu chrome
 * as well as text). This path is near-zero-covered today -- no committed
 * golden fixture opens a menu at all.
 *
 * Six options (GQ_MENU_MAX_OPTIONS, the max allowed) with a prompt, so both
 * the option-count boundary and the vertical layout (prompt + 6 rows) are
 * exercised. Option labels deliberately vary in length: a 1-char label, a
 * few normal ones, and a full 21-char (max) label positioned to run off the
 * right edge of the display (menu.c draws option labels starting at x=15,
 * so 15 + 21*6 = 141 >> 127) -- the same off-canvas-clipping regression
 * shape as perf_text.gq's label3, but inside menu chrome instead of a plain
 * label.
 *
 * Navigation exercises the *internal* menu input hijack in
 * handle_events()/handle_event_menu_choice() (menu.c) -- input(L)/input(R)
 * move the selection cursor, input(A) confirms -- which happens entirely
 * outside this stage's own `event input(...)` handlers (those are bypassed
 * while a choice menu is active; only input(A)/(L)/(R) are hijacked,
 * input(B) is NOT, per handle_event_menu_choice()'s switch). On confirm,
 * `event menu` fires with GQI_MENU_VALUE set to the selected option's
 * value; label1 is updated to show it, proving the menu-close -> label
 * redraw sequence too.
 *
 * Emulator-confirmed (headless --dump + scripted --input, this PR's
 * report): initial menu render (6 options, prompt, hint bar), cursor
 * navigation (down x2), and confirm -> label1 update.
 */

game {
    id = 105;
    title := "PerfMenuC";
    author := "perf";
    starting_stage = start;
}

volatile {
    str sel_str := "";
}

menus {
    choices {
        1: "1";
        2: "Short";
        3: "A Normal Option";
        4: "EdgeRight21charsLong!";
        5: "Another One";
        6: "Last Option Six";
    }
}

stage start {
    menu choices prompt "Pick one:";

    event menu {
        GQI_LABEL1_X = 0;
        GQI_LABEL1_Y = 0;
        sel_str := str(GQI_MENU_VALUE);
        GQS_LABEL1 := "Selected: " + sel_str;
    }
}
